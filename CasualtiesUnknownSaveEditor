function validate(){
  var errs = [], warns = [];
  if (!S.save) return { errs:[{msg:'尚未载入存档'}], warns:[] };
  var j = S.save;
  ['body','limbs','items','itemComponents','bodyComponents','limbComponents','savedRecipeData','runSettings'].forEach(function(k){
    if (j[k] === undefined) errs.push({msg:'缺少顶层字段 ' + k});
  });
  if (Array.isArray(j.items) && Array.isArray(j.itemComponents) && j.items.length !== j.itemComponents.length)
    errs.push({msg:'items 与 itemComponents 长度不一致（' + j.items.length + ' vs ' + j.itemComponents.length + '），游戏会读错组件'});
  if (Array.isArray(j.limbs) && Array.isArray(j.limbComponents) && j.limbs.length !== j.limbComponents.length)
    errs.push({msg:'limbs 与 limbComponents 长度不一致'});
  if (j.savedRecipeData && Array.isArray(j.savedRecipeData.saved) && DB.recipes.length && j.savedRecipeData.saved.length !== DB.recipes.length)
    warns.push({msg:'配方表长度 ' + j.savedRecipeData.saved.length + ' 与游戏当前配方数 ' + DB.recipes.length + ' 不同（游戏版本可能已更新）'});
  // 物品合法性
  var isContainer = function(id){
    if (DB.containers && DB.containers.containerIds) return DB.containers.containerIds.indexOf(id) >= 0;
    return null;
  };
  var slotHead = {};
  var unknownIds = [];
  (j.items||[]).forEach(function(it, i){
    if (!DB.itemById[it.id]) unknownIds.push('#' + i + ' ' + it.id);
    if (typeof it.condition !== 'number' || isNaN(it.condition) || it.condition < 0)
      errs.push({msg:'物品 #' + i + ' condition 非法: ' + it.condition});
    else if (it.condition > 1)
      warns.push({msg:'物品 #' + i + ' condition=' + it.condition + ' > 1（游戏里通常上限 1.0）'});
    if (it.slot >= 0){
      if (it.slot >= HAND_SLOTS) warns.push({msg:'物品 #' + i + ' 槽位 ' + it.slot + ' 超出手部槽位范围 0-' + (HAND_SLOTS-1) + '，读档时该物品会被丢弃'});
      if (!(it.slot in slotHead)) slotHead[it.slot] = {idx:i, id:it.id, n:0};
      else slotHead[it.slot].n++;
    } else if (it.wearSlot == null){
      warns.push({msg:'物品 #' + i + ' 既无槽位也无穿戴位，读档时会走穿戴逻辑'});
    }
  });
  if (unknownIds.length) warns.push({msg:'有 ' + unknownIds.length + ' 件物品 id 不在游戏物品表中，读档时会被跳过：' + unknownIds.slice(0,8).join('，') + (unknownIds.length > 8 ? ' …' : '')});
  // 穿戴位同理：同 wearSlot 的多件物品会被塞进第一件的容器
  var wearHead = {};
  (j.items||[]).forEach(function(it, i){
    if (it.slot >= 0 || !it.wearSlot) return;
    if (!(it.wearSlot in wearHead)) wearHead[it.wearSlot] = {idx:i, id:it.id, n:0};
    else wearHead[it.wearSlot].n++;
  });
  Object.keys(wearHead).forEach(function(w){
    var head = wearHead[w];
    if (!head.n) return;
    if (isContainer(head.id) === true) return;
    warns.push({msg:'穿戴位 ' + wearSlotName(w) + ' 里有 ' + (head.n + 1) + ' 件物品，槽主 "' + itemName(head.id) + '"（' + head.id + '）'
      + (isContainer(head.id) === false ? '不是容器' : '的容器属性未知') + '，多出的 ' + head.n + ' 件读档时可能被丢弃'});
  });
  Object.keys(slotHead).forEach(function(s){
    var head = slotHead[s];
    if (!head.n) return;
    var c = isContainer(head.id);
    if (c === true) return;                                   // 已知容器：同槽位多物品是正常玩法
    warns.push({msg:'槽位 ' + s + ' 里有 ' + (head.n + 1) + ' 件物品，但槽主 "' + itemName(head.id) + '"（' + head.id + '）'
      + (c === false ? '不是容器' : '的容器属性未知') + '，多出的 ' + head.n + ' 件读档时可能被丢弃'});
  });
  // 类型检查：整数字段不能被写成小数
  DB.fields.forEach(function(f){
    if (f.csharpType !== 'int') return;
    [['body', f.name], ['body', 'skills', f.name]].forEach(function(p){
      var v = getPath(p);
      if (typeof v === 'number' && !Number.isInteger(v))
        errs.push({msg:p.join('.') + ' 是 int 字段，给了小数 ' + v + '：游戏 Convert.ChangeType 不会报错，但会**静默四舍五入**成 ' + Math.round(v) + '，请直接填整数'});
    });
  });
  if (j.cheatedSave === true) warns.push({msg:'cheatedSave = true：读档后会禁用本次运行的成就，不想关成就请改为 false'});
  return { errs: errs, warns: warns };
}

