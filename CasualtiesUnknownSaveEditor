/* ---------- 液体内容 ---------- */
function getWaterComp(i){
  var comps = S.save.itemComponents || [];
  var c = comps[i];
  if (!c) return null;
  if (c[WATERCOMP]) return { comp: c[WATERCOMP], key: WATERCOMP };
  for (var k in c){ if (k.indexOf('WaterContainerItem') === 0) return { comp: c[k], key: k }; }
  return null;
}

function liquidSummary(stack){
  if (!stack || !stack.length) return null;
  return stack.map(function(s){ return liquidName(s.liquidId) + ' ' + Math.round(s.amount); }).join(' · ');
}

function liquidCell(i){
  var it = S.save.items[i];
  var w = getWaterComp(i);
  var stack = w && w.comp ? w.comp.stack : null;
  var cap = itemCapacity(it.id);
  var total = (stack || []).reduce(function(a, s){ return a + (s.amount || 0); }, 0);
  var full = liquidSummary(stack);
  // 多种液体时摘要只显示第一种 + 种类数，完整清单放 title，避免撑破单元格
  var label = full;
  if (stack && stack.length > 1) label = liquidName(stack[0].liquidId) + ' 等 ' + stack.length + ' 种';
  if (!full && !isLiquidVessel(it.id)) return h('span', {class:'tag muted', text:'—'});
  var btn = h('button', {class:'liqbtn', title: full ? (full + (cap ? '　/　容量 ' + cap + ' ml' : '')) : '', onclick:function(){ liquidDialog(i); }},
    h('span', {class:'liqdot', style:'background:' + ((stack && stack[0]) ? liquidColor(stack[0].liquidId) : '#444')}),
    h('span', {text: label || (isLiquidVessel(it.id) ? '空' : '—')}),
    cap ? h('span', {class:'tag muted', text: ' ' + Math.round(total) + '/' + cap}) : null);
  if (cap && total > cap) btn.classList.add('over');
  return btn;
}

function liquidDialog(i){
  var it = S.save.items[i];
  var cap = itemCapacity(it.id);
  var overlay = h('div', {class:'overlay'});
  function close(){ if (overlay.parentNode) document.body.removeChild(overlay); }
  function row(s, idx){
    var sel = h('select');
    DB.liquids.forEach(function(l){
      var op = h('option', {value:l.id, text: l.name || l.id});
      if (l.id === s.liquidId) op.selected = true;
      sel.appendChild(op);
    });
    if (!DB.liquidById[s.liquidId]){
      var op2 = h('option', {value:s.liquidId, text:s.liquidId + '（未知）'}); op2.selected = true; sel.appendChild(op2);
    }
    sel.addEventListener('change', function(){ s.liquidId = sel.value; dot.style.background = liquidColor(s.liquidId); totalEl.textContent = totalText(); refreshFooter(); });
    var amt = h('input', {type:'number', step:'1', value:String(s.amount)});
    amt.addEventListener('change', function(){
      var v = parseFloat(amt.value); if (isNaN(v)) return;
      if (v < 0) v = 0;
      s.amount = v; totalEl.textContent = totalText(); refreshFooter();
    });
    var dot = h('span', {class:'liqdot', style:'background:' + liquidColor(s.liquidId)});
    var del = h('button', {class:'iconbtn', text:'✕', title:'删除这条液体', onclick:function(){
      stack.splice(idx, 1); refreshFooter(); redraw();
    }});
    return h('div', {class:'liqrow'}, dot, sel, amt, h('span', {class:'tag muted', text:'ml'}), del);
  }
  var stack, totalEl, bodyWrap = h('div');
  function totalText(){
    var t = (stack || []).reduce(function(a, s){ return a + (s.amount || 0); }, 0);
    return '合计 ' + Math.round(t) + (cap ? ' / 容量 ' + cap : '') + ' ml' + (cap && t > cap ? '　⚠ 超出容量' : '');
  }
  function redraw(){
    clear(bodyWrap);
    var w = getWaterComp(i);
    stack = (w && w.comp) ? (w.comp.stack = w.comp.stack || []) : [];
    if (!w && isLiquidVessel(it.id)){
      bodyWrap.appendChild(h('div', {class:'note', text:'这件物品在游戏里可以装液体，但存档里没有它的液体组件记录。点下面按钮创建一条空的（不改动其它数据）。'}));
      bodyWrap.appendChild(h('button', {class:'btn', text:'创建液体组件', onclick:function(){
        var comps = (S.save.itemComponents = S.save.itemComponents || []);
        comps[i] = comps[i] || {};
        comps[i][WATERCOMP] = {stack: []};
        refreshFooter(); redraw();
      }}));
      return;
    }
    if (!w){
      bodyWrap.appendChild(h('div', {class:'note', text:'这件物品不是液体容器，没有可编辑的液体内容。'}));
      return;
    }
    stack = w.comp.stack = (w.comp.stack || []);
    totalEl = h('div', {class:'sub', text: totalText()});
    bodyWrap.appendChild(totalEl);
    if (!stack.length) bodyWrap.appendChild(h('div', {class:'sub', text:'（空）'}));
    stack.forEach(function(s, idx){ bodyWrap.appendChild(row(s, idx)); });
    bodyWrap.appendChild(h('div', {class:'row', style:'margin-top:10px'},
      h('button', {class:'btn', text:'＋ 添加一种液体', onclick:function(){
        var used = stack.reduce(function(a, s){ return a + (s.amount || 0); }, 0);
        var left = cap ? Math.max(0, Math.round(cap - used)) : 100;
        stack.push({liquidId:'water', amount: left || 100});
        refreshFooter(); redraw();
      }})));
  }
  var card = h('div', {class:'modal'},
    h('div', {style:'font-size:16px;font-weight:600;margin-bottom:2px', text:'液体内容 · ' + itemName(it.id)}),
    h('div', {class:'id', style:'font-family:var(--mono);color:#6b7889;font-size:11.5px;margin-bottom:12px',
      text: it.id + (cap ? '  ·  容量 ' + cap + ' ml' : '  ·  容量未知')}),
    bodyWrap,
    h('div', {class:'row', style:'justify-content:flex-end;margin-top:16px'},
      h('button', {class:'btn primary', text:'关闭', onclick:close})));
  overlay.appendChild(card);
  overlay.addEventListener('click', function(e){ if (e.target === overlay) close(); });
  document.body.appendChild(overlay);
  redraw();
}

function renderAddResults(q, box){
  clear(box);
  q = (q||'').trim().toLowerCase();
  if (!q){ box.appendChild(h('div', {class:'sub', text:'输入关键字即可搜索 ' + DB.items.length + ' 件物品（支持中文名 / 英文名 / id）。'})); return; }
  var hits = DB.items.filter(function(it){
    return (it.id && it.id.toLowerCase().indexOf(q) >= 0) || (it.name && it.name.indexOf(q) >= 0) || (it.nameEn && it.nameEn.toLowerCase().indexOf(q) >= 0);
  }).slice(0, 40);
  if (!hits.length){ box.appendChild(h('div', {class:'sub', text:'没有匹配的物品'})); return; }
  var wrap = h('div', {class:'presetbar'});
  hits.forEach(function(it){
    wrap.appendChild(h('button', {class:'preset', title:(it.desc || '') + '  [' + it.id + ']', onclick:function(){ addItemDialog(it); }},
      h('span', {text: it.name || it.nameEn || it.id}),
      h('span', {class:'tag muted', text: it.id})));
  });
  box.appendChild(wrap);
}

function isContainerItem(id){
  return !!(DB.containers && DB.containers.containerIds && DB.containers.containerIds.indexOf(id) >= 0);
}

function addItemDialog(it){
  var items = S.save.items || [];
  var slotSel = h('select');
  for (var s=0; s<HAND_SLOTS; s++){
    var occupied = items.some(function(x){ return x.slot === s; });
