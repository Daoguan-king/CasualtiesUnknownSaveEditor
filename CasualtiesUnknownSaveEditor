function fmtVal(v){
  if (v === undefined) return '(无)';
  var s = (typeof v === 'object') ? JSON.stringify(v) : String(v);
  return s.length > 60 ? s.slice(0,60) + '…' : s;
}</script>
<script>/* ================= 应用外壳 ================= */
