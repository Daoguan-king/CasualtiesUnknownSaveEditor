<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Casualties: Unknown 存档修改器</title>
<style>:root{
  --bg:#0b0d10; --bg2:#12151a; --bg3:#181c23; --line:#252b35; --line2:#323a47;
  --fg:#e6ecf5; --fg2:#9aa7b8; --fg3:#6b7889;
  --accent:#91d1ff; --accent2:#5aa9e6;
  --warn:#ffb454; --bad:#ff5c7a; --good:#6ee7a8;
  --mono:ui-monospace,"Cascadia Mono",Consolas,monospace;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{
  background:radial-gradient(1200px 600px at 15% -10%,#16202e 0%,transparent 60%),var(--bg);
  color:var(--fg); font:14px/1.5 "Segoe UI","Microsoft YaHei",system-ui,sans-serif;
  display:flex; flex-direction:column; overflow:hidden;
}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
input[type=number]::-webkit-outer-spin-button,
input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
input[type=number]{-moz-appearance:textfield;appearance:textfield}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-thumb{background:#2b333f;border-radius:6px}
::-webkit-scrollbar-thumb:hover{background:#3a4553}
::-webkit-scrollbar-track{background:transparent}

/* ---------- top bar ---------- */
#topbar{
  display:flex;align-items:center;gap:14px;padding:10px 16px;
  background:linear-gradient(180deg,#121821,#0e1319);border-bottom:1px solid var(--line);
  flex:0 0 auto;z-index:5;
}
#brand{font-weight:700;letter-spacing:.5px;font-size:15px;white-space:nowrap}
#brand small{color:var(--fg3);font-weight:400;margin-left:8px;letter-spacing:0}
#filecard{
  display:flex;align-items:center;gap:10px;padding:5px 12px;border:1px dashed var(--line2);
  border-radius:8px;color:var(--fg2);font-size:13px;min-width:0;
}
#filecard.loaded{border-style:solid;border-color:#2e4256;background:#101a24;color:var(--fg)}
#filecard .fname{font-family:var(--mono);color:var(--accent);max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.spacer{flex:1}
.btn{
  background:#1b2430;border:1px solid var(--line2);border-radius:7px;padding:7px 13px;
  transition:.12s;white-space:nowrap;
}
.btn:hover{background:#233040;border-color:#46586e}
.btn:active{transform:translateY(1px)}
.btn.primary{background:#16405c;border-color:#2c6f9e;color:#d6ecff}
.btn.primary:hover{background:#1b5279}
.btn.danger:hover{background:#3a1a24;border-color:#7a2f42;color:#ffc9d4}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none}

/* ---------- layout ---------- */
#main{flex:1;display:flex;min-height:0}
#side{
  width:210px;flex:0 0 auto;border-right:1px solid var(--line);
  background:#0d1116;padding:12px 8px;overflow:auto;
}
#side .navitem{
  display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:7px;
  color:var(--fg2);cursor:pointer;user-select:none;margin-bottom:2px;font-size:13.5px;
}
#side .navitem:hover{background:#161d26;color:var(--fg)}
#side .navitem.active{background:#152838;color:var(--accent);font-weight:600}
#side .navitem .dot{margin-left:auto;width:6px;height:6px;border-radius:50%;background:var(--warn);opacity:0;transition:.2s}
#side .navitem.dirty .dot{opacity:1}
#side .navsec{color:var(--fg3);font-size:11px;letter-spacing:1.2px;padding:14px 11px 6px;text-transform:uppercase}
#side .hint{color:var(--fg3);font-size:11px;padding:10px 6px;line-height:1.55;word-break:break-all}
#side .hint kbd{font-size:10px;padding:1px 3px;word-break:break-all;display:inline-block}

#content{flex:1;overflow:auto;padding:20px 24px 80px;min-width:0}
#content h2{margin:0 0 4px;font-size:19px}
#content .sub{color:var(--fg3);font-size:12.5px;margin-bottom:18px}

/* ---------- cards / groups ---------- */
.group{
  background:var(--bg2);border:1px solid var(--line);border-radius:10px;
  margin-bottom:16px;overflow:hidden;
}
.group>summary{
  list-style:none;cursor:pointer;padding:11px 15px;display:flex;align-items:center;gap:9px;
  background:#141922;font-weight:600;font-size:13.5px;user-select:none;
}
.group>summary::-webkit-details-marker{display:none}
.group>summary::before{content:"▸";color:var(--fg3);transition:.15s;font-size:11px}
.group[open]>summary::before{transform:rotate(90deg)}
.group>summary .cnt{margin-left:auto;color:var(--fg3);font-weight:400;font-size:12px}
.group .body{padding:6px 15px 14px}
.group.dirty>summary{background:#1a2130}
.group.dirty>summary .cnt{color:var(--warn)}

/* ---------- field rows ---------- */
.field{
  display:grid;grid-template-columns:minmax(120px,220px) 1fr auto;gap:12px;align-items:center;
  padding:7px 0;border-bottom:1px solid #1b212b;
}
.field:last-child{border-bottom:0}
.field.changed{background:linear-gradient(90deg,rgba(255,180,84,.07),transparent 70%)}
.field .lbl{color:var(--fg2);font-size:13px;display:flex;flex-direction:column;gap:1px;min-width:0}
.field .lbl .k{font-family:var(--mono);font-size:10.5px;color:var(--fg3)}
.field .ctl{display:flex;align-items:center;gap:9px;min-width:0}
.field .ctl input[type=range]{flex:1;min-width:60px}
.field .ctl input[type=number]{
  width:112px;background:#0c1116;border:1px solid var(--line2);border-radius:6px;
  padding:5px 8px;font-family:var(--mono);font-size:13px;
}
.field .ctl input[type=number]:focus{outline:none;border-color:var(--accent2);box-shadow:0 0 0 2px rgba(90,169,230,.15)}
.field .ctl input[type=text]{
  flex:1;min-width:100px;background:#0c1116;border:1px solid var(--line2);border-radius:6px;padding:5px 8px;
}
.field .ctl select{
  background:#0c1116;border:1px solid var(--line2);border-radius:6px;padding:5px 8px;min-width:112px;
}
.field .tag{font-size:11px;color:var(--fg3);font-family:var(--mono);white-space:nowrap}
.field .tag.muted{color:#4d5867}

/* toggle switch */
.sw{position:relative;width:42px;height:22px;flex:0 0 auto}
.sw input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
.sw span{
  position:absolute;inset:0;background:#20262f;border:1px solid var(--line2);border-radius:20px;
  transition:.15s;pointer-events:none;
}
.sw span::after{
  content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;
  background:#63707f;transition:.15s;
}
.sw input:checked+span{background:#14445f;border-color:#2c6f9e}
.sw input:checked+span::after{transform:translateX(20px);background:var(--accent)}

/* ---------- item table ---------- */
table.items{width:100%;border-collapse:collapse;font-size:13px}
table.items th{
  text-align:left;color:var(--fg3);font-size:11.5px;font-weight:600;letter-spacing:.6px;
  padding:6px 8px;border-bottom:1px solid var(--line2);position:sticky;top:-20px;background:var(--bg2);
}
table.items td{padding:4px 6px;border-bottom:1px solid #1b212b;vertical-align:middle}
table.items tr:hover td{background:#151b23}
table.items tr.child td:first-child{padding-left:26px;position:relative}
table.items tr.child td:first-child::before{content:"└";position:absolute;left:12px;color:#3d4a5a}
table.items .nm{color:var(--fg)}
table.items .id{font-family:var(--mono);font-size:10.5px;color:var(--fg3)}
table.items input[type=number]{
  width:74px;background:#0c1116;border:1px solid var(--line2);border-radius:5px;padding:3px 6px;
  font-family:var(--mono);font-size:12px;
}
table.items select{background:#0c1116;border:1px solid var(--line2);border-radius:5px;padding:3px 5px;font-size:12px}
.iconbtn{
  background:transparent;border:1px solid transparent;border-radius:5px;color:var(--fg3);
  padding:2px 7px;font-size:12px;
}
.iconbtn:hover{background:#2a1620;border-color:#5c2634;color:#ffb3c1}

/* ---------- misc ---------- */
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.search{
  background:#0c1116;border:1px solid var(--line2);border-radius:7px;padding:7px 11px;min-width:240px;
}
.search:focus{outline:none;border-color:var(--accent2)}
.note{
  background:#101a24;border:1px solid #22344a;border-left:3px solid var(--accent2);
  border-radius:7px;padding:11px 14px;color:var(--fg2);font-size:12.5px;line-height:1.65;margin-bottom:16px;
}
.note.warn{background:#221a10;border-color:#4a3a1e;border-left-color:var(--warn)}
.note.bad{background:#241318;border-color:#4a2230;border-left-color:var(--bad)}
.note b{color:var(--fg)}
.kv{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px;margin-bottom:16px}
.kv .cell{background:var(--bg3);border:1px solid var(--line);border-radius:9px;padding:11px 13px}
.kv .cell .t{color:var(--fg3);font-size:11.5px;margin-bottom:3px}
.kv .cell .v{font-size:17px;font-family:var(--mono);color:var(--accent)}
.presetbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.preset{
  background:#16202b;border:1px solid #26374a;border-radius:8px;padding:8px 13px;font-size:13px;
  display:flex;align-items:center;gap:7px;transition:.12s;
}
.preset:hover{background:#1d2b3a;border-color:#3a5675;transform:translateY(-1px)}
.preset .i{font-size:15px}
pre.json{
  background:#080b0f;border:1px solid var(--line);border-radius:9px;padding:14px;
  font-family:var(--mono);font-size:12px;line-height:1.55;overflow:auto;max-height:60vh;color:#b9c6d6;
}
.difflist{font-family:var(--mono);font-size:12px;max-height:44vh;overflow:auto}
.difflist div{padding:3px 0;border-bottom:1px solid #1b212b;display:flex;gap:10px}
.difflist .p{color:var(--fg2);flex:0 0 320px;overflow:hidden;text-overflow:ellipsis}
.difflist .a{color:var(--bad)}
.difflist .b{color:var(--good)}
.ok{color:var(--good)} .err{color:var(--bad)} .warnc{color:var(--warn)}
.badge{display:inline-block;padding:1px 7px;border-radius:20px;font-size:11px;background:#1d2633;color:var(--fg2);border:1px solid var(--line2)}
.badge.ok{background:#12301f;color:var(--good);border-color:#1e5335}
.badge.err{background:#311521;color:var(--bad);border-color:#5c2436}
.badge.warn{background:#302515;color:var(--warn);border-color:#5c4520}

#bottombar{
  flex:0 0 auto;display:flex;align-items:center;gap:12px;padding:10px 18px;
  background:linear-gradient(0deg,#10151b,#0d1116);border-top:1px solid var(--line);
}
#status{color:var(--fg2);font-size:12.5px}
#status b{color:var(--warn)}
#drop{
  position:fixed;inset:0;background:rgba(10,16,24,.88);backdrop-filter:blur(3px);
  display:none;place-items:center;z-index:50;font-size:20px;color:var(--accent);
  border:2px dashed #2c6f9e;border-radius:14px;margin:14px;
}
#drop.show{display:grid}
#toast{
  position:fixed;bottom:64px;left:50%;transform:translateX(-50%) translateY(14px);
  background:#16232f;border:1px solid #2c6f9e;color:#d6ecff;padding:10px 20px;border-radius:9px;
  opacity:0;transition:.25s;pointer-events:none;z-index:60;box-shadow:0 8px 30px rgba(0,0,0,.5);
}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.bad{border-color:#7a2f42;background:#241722;color:#ffc9d4}
/* 取色条（对齐游戏 Item.ColorSwatches 8 色） */
.tablescroll{overflow-x:auto;margin:0 -4px;padding:0 4px}
.swatchbar{display:flex;gap:2px}
.chip{width:14px;height:14px;border-radius:3px;border:1px solid rgba(0,0,0,.55);padding:0;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);transition:.1s}
.chip:hover{transform:scale(1.18)}
.chip.on{outline:2px solid var(--accent);outline-offset:1px;box-shadow:0 0 6px rgba(145,209,255,.6)}

/* 液体按钮与编辑弹窗 */
.liqbtn{display:inline-flex;align-items:center;gap:5px;background:#0f1620;border:1px solid var(--line2);
  border-radius:6px;padding:3px 7px;font-size:11.5px;color:var(--fg2);max-width:172px;overflow:hidden;white-space:nowrap}
.liqbtn:hover{background:#16222f;border-color:#3d566f;color:var(--fg)}
.liqbtn.over{border-color:#7a2f42;color:#ffb3c1}
.liqdot{width:10px;height:10px;border-radius:50%;flex:0 0 auto;box-shadow:0 0 0 1px rgba(0,0,0,.5)}
.overlay{position:fixed;inset:0;background:rgba(6,9,13,.75);z-index:80;display:grid;place-items:center}
.modal{background:#12171e;border:1px solid #2b3542;border-radius:12px;padding:18px 20px;min-width:440px;
  max-width:min(680px,92vw);box-shadow:0 20px 60px rgba(0,0,0,.6);max-height:86vh;overflow:auto}
.liqrow{display:grid;grid-template-columns:14px 1fr 92px 26px 28px;gap:8px;align-items:center;padding:5px 0;
  border-bottom:1px solid #1b212b}
.liqrow select{background:#0c1116;border:1px solid var(--line2);border-radius:6px;padding:4px 7px;min-width:0}
.liqrow input{background:#0c1116;border:1px solid var(--line2);border-radius:6px;padding:4px 7px;
  font-family:var(--mono);font-size:12.5px;width:92px}

.empty{color:var(--fg3);text-align:center;padding:60px 20px;font-size:13.5px;line-height:2}
kbd{background:#1b2330;border:1px solid var(--line2);border-bottom-width:2px;border-radius:4px;padding:1px 6px;font-family:var(--mono);font-size:11.5px}
</style>
</head>
