/* ---------- 读取存档 ---------- */
async function loadBytes(bytes, name, handle){
  var text = await gunzip(bytes);
  var json;
  try { json = JSON.parse(text); }
  catch (e){ throw new Error('gzip 解开了，但内容不是合法 JSON：' + e.message); }
  if (!json.body) throw new Error('这份文件不像 Casualties: Unknown 存档（缺少 body 字段）');
  S.save = json;
  S.orig = JSON.parse(JSON.stringify(json));
  S.fileName = name || 'save.sv';
  S.fileHandle = handle || null;
  S.panel = 'overview';
  updateFileCard();
  renderPanel();
  toast('已载入 ' + S.fileName + '（body ' + Object.keys(json.body).length + ' 项 / 物品 ' + (json.items||[]).length + ' 件）');
}

async function loadFile(file){
  try {
    var bytes = new Uint8Array(await file.arrayBuffer());
    var handle = null;
    if (window.__lastHandle) { handle = window.__lastHandle; window.__lastHandle = null; }
    await loadBytes(bytes, file.name, handle);
  } catch (e){ toast('载入失败：' + e.message, true); console.error(e); }
}

async function openPicker(){
  if (window.showOpenFilePicker){
    try {
      var handles = await window.showOpenFilePicker({
        multiple:false,
        types:[{description:'Casualties 存档', accept:{'application/octet-stream':['.sv','.sav','.json']}}]
      });
      var fh = handles[0];
      var file = await fh.getFile();
      window.__lastHandle = fh;
      await loadFile(file);
      return;
    } catch (e){
      if (e && e.name === 'AbortError') return;
      console.warn('showOpenFilePicker 不可用，回退到 input', e);
    }
  }
  document.getElementById('fileinput').click();
}

function updateFileCard(){
  var card = document.getElementById('filecard');
  clear(card);
  if (S.save){
    card.className = 'loaded';
    card.appendChild(h('span', {text:'📄'}));
    card.appendChild(h('span', {class:'fname', text:S.fileName}));
    card.appendChild(h('span', {class:'tag muted', text: S.fileHandle ? '可覆盖原文件' : '需另存'}));
  } else {
    card.className = '';
    card.appendChild(h('span', {text:'未载入存档'}));
  }
}

/* ---------- 写回 ---------- */
async function doSave(asDownload){
  if (!S.save) return;
  var v = validate();
  if (v.errs.length){
    if (!confirm('发现 ' + v.errs.length + ' 个会破坏存档的错误：\n\n' + v.errs.slice(0,6).map(function(e){ return '· ' + e.msg; }).join('\n') + '\n\n仍要写入吗？（不推荐）')) return;
  }
  var text = toAsciiJson(S.save);
  var bytes = await gzipText(text);
  var written = false;
  if (S.fileHandle && !asDownload){
    try {
      var w = await S.fileHandle.createWritable();
      await w.write(bytes);
      await w.close();
      written = true;
    } catch (e){
      toast('覆盖原文件失败：' + e.message + '，改为下载', true);
    }
  }
  if (!written){
    var blob = new Blob([bytes], {type:'application/gzip'});
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'save.sv';
    document.body.appendChild(a); a.click();
    setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 1500);
    toast('已生成 save.sv，请放回存档目录替换原文件');
  } else {
    toast('已写回 ' + S.fileName);
  }
  S.orig = JSON.parse(JSON.stringify(S.save));
  refreshFooter();
  renderPanel();
}

/* ---------- 启动 ---------- */
function boot(){
  document.getElementById('btnOpen').addEventListener('click', openPicker);
  document.getElementById('btnSaveTop').addEventListener('click', function(){ doSave(false); });
  document.getElementById('fileinput').addEventListener('change', function(e){
    var f = e.target.files && e.target.files[0];
    if (f) loadFile(f);
    e.target.value = '';
  });

  var dz = document.getElementById('drop');
  var depth = 0;
  window.addEventListener('dragenter', function(e){ e.preventDefault(); depth++; dz.classList.add('show'); });
  window.addEventListener('dragover', function(e){ e.preventDefault(); });
  window.addEventListener('dragleave', function(e){ e.preventDefault(); if (--depth <= 0){ depth = 0; dz.classList.remove('show'); } });
  window.addEventListener('drop', function(e){
    e.preventDefault(); depth = 0; dz.classList.remove('show');
    var f = e.dataTransfer.files && e.dataTransfer.files[0];
    if (f) loadFile(f);
  });
  updateFileCard();
  renderPanel();
}
document.addEventListener('DOMContentLoaded', boot);
</script>
